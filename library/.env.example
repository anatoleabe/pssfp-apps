# Obligatoire en production pour `next build` (sinon le build échoue, sauf si CI est défini : l'URL
# est figée dans le bundle client) ET pour `next start` (la configuration refuse de démarrer sans elle) :
# env pm2 ou .env.production sur le VPS. Production : https://api.pssfp.org/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:6001
NEXT_PUBLIC_SITE_URL=http://localhost:6002
NEXT_PUBLIC_TURNSTILE_SITE_KEY=__a_definir__
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_FOAD_URL=https://foad.pssfp.net
